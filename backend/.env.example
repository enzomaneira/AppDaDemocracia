# Copie para .env e ajuste. Sem DATABASE_URL, o backend usa SQLite local (./dev.db).
DATABASE_URL=postgresql://mandato:mandato@localhost:5432/mandato
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_MIN=15
CORS_ORIGINS=["http://localhost:5173"]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEWS_API_KEY=
LLM_API_KEY=

# Conta de teste usada nos testes manuais locais (crie pelo /cadastro; nunca use em produção)
# DEV_TEST_EMAIL=teste.local@example.com
# DEV_TEST_PASSWORD=senha-de-teste-123

# Ingestão (dev): limite de parlamentares por casa (0 = todos) e janela em dias
SYNC_LIMIT=0
SYNC_DAYS_BACK=1
